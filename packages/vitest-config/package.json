{
  "name": "@repo/vitest-config",
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./base": "./dist/configs/base-config.js",
    "./api": "./dist/configs/api-config.js",
    "./web": "./dist/configs/web-config.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit",
    "merge-blob-reports": "node dist/scripts/merge-blob-reports.js",
    "report": "vitest run --merge-reports coverage/merged-blob --passWithNoTests --coverage --coverage.provider=istanbul --coverage.reporter=html --coverage.reporter=text --coverage.reportsDirectory=coverage/report",
    "view-report": "open coverage/report/index.html"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@vitest/coverage-istanbul": "^5.0.0",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
